# Copy this file to .env and fill in your Supabase project's values.
# Find both under: Supabase Dashboard -> Project Settings -> API

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# On Netlify, set these same two keys under:
# Site configuration -> Environment variables -> Add a variable
# Then redeploy (Vite bakes env vars in at BUILD time, not runtime).
